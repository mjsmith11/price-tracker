# --- Database ---
DATABASE_URL=sqlite:////data/price_tracker.db

# --- Scraping ---
SCRAPE_INTERVAL_HOURS=6

# Price history older than this is pruned daily. The whole point of this app
# is long-term trend history, so this is a safety valve against years of
# unbounded growth, not aggressive cleanup. Set to 0 to disable.
PRICE_HISTORY_RETENTION_DAYS=730

# --- Email notifications (SMTP) ---
# Gmail example: create an "app password" at https://myaccount.google.com/apppasswords
# (requires 2-step verification enabled on the account). Do NOT use your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com
